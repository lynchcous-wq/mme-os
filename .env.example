# Public Supabase project configuration. Safe to expose to browser code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret. Never prefix with NEXT_PUBLIC_ or expose to browser code.
# Store this value in the deployment platform's encrypted secret manager.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
